---
import "@fortawesome/fontawesome-free/css/all.min.css";
import "../../styles/global.css";
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import StarryBackground from '../../components/StarryBackground.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				display: flex;
				flex-direction: column;
				flex:1;
				min-height: 100vh;
			}
			main {
				width: 100%;
				max-width: 1260px;
				box-sizing: border-box;
				}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fit,minmax(340px,1fr));
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
				align-items: stretch;
			}
			ul li {
				min-width: calc(30% - 1rem);
				height: 100%;
			}
			
			.card-footer {
				display: flex;
				flex-direction: row;
				font-size: medium;
				align-items: center;
				margin-top: auto;
				bottom: 10%;
				border-top: 1px solid rgb(var(--gray-light));
			}

			.BlogCard {
				height: 100%;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
			}

			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: flex;
				flex-direction: column;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				
			}
			footer {
				align-self: flex-end;
			}
		</style>
	</head>
	<body>
		<Header />
		<StarryBackground></StarryBackground>
		<main>
			<p class="Blog-intro">This is my blog section. I haven't planned a specific topic to post about as of yet. Although you can expect anything related to low-level software since that's much more interesting 😤. Read them and Enjoy 😉.</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a class="BlogCard" {...(post.data.is_anchor ? { href: `/blog/${post.id}/` } : {})}>
									{/* <div class="BlogCard"> */}
										{/* {post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										)} */}
										<h4 class="card-title">{post.data.title}</h4>
										<p class="card-description">{post.data.description}</p>
										<div class="tags">
											{post.data.tags.map((tag)=>(
												<p class="tag">{tag}</p>
											)
										)}
										</div>
										<div class="card-footer">
											<p class="card-date">
												<i class="fas fa-clock"></i>
												<FormattedDate date={post.data.pubDate} />
											</p>
											<div class="card-types">
												{post.data.type.length>0 && <i class="fas fa-folder"></i>}
												{
													post.data.type.map((type)=>(
														<p class="card-type">{type}</p>
													))
												}
											</div>
										</div>
									{/* </div> */}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

