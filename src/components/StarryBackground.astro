<canvas id="star-canvas"></canvas>

<style>
#star-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at bottom, #080d12 0%, #090a0f 80%);
}
</style>

<script>
const canvas = document.getElementById("star-canvas");
const ctx = canvas.getContext("2d");

const starsSmall = [];
const starsMedium = [];
const starsLarge = [];
const shootingStars = [];

const SMALL = 150;
const MEDIUM = 45;
const LARGE = 15;

function randomStar(radius, color) {
    return {
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: radius,
        color,
        alpha: Math.random(),
        speed: 0.2 + Math.random() * 0.4,
        twinkle: Math.random() * Math.PI * 2
    };
}

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    starsSmall.length = 0;
    starsMedium.length = 0;
    starsLarge.length = 0;

    for (let i = 0; i < SMALL; i++)
        starsSmall.push(randomStar(1, "#ffffff"));

    for (let i = 0; i < MEDIUM; i++)
        starsMedium.push(randomStar(2, "#cfe8ff"));

    for (let i = 0; i < LARGE; i++)
        starsLarge.push(randomStar(3, "#fff7d6"));
}

window.addEventListener("resize", resize);
resize();

function createShootingStar() {
    if(shootingStars.length >=2)
      return;
    shootingStars.push({
        x: canvas.width + 100,
        y: Math.random() * canvas.height * 0.4,
        vx: -12,
        vy: 7,
        life: 0,
        maxLife: 60
    });
}

setInterval(() => {
    if (Math.random() < 0.6)
        createShootingStar();
}, 6000);

function drawNebula(time) {

    const t = time * 0.00005;

    drawNebulaBlob(
        canvas.width * (0.25 + 0.03 * Math.sin(t)),
        canvas.height * 0.30,
        canvas.width * 0.35,
        canvas.height * 0.24,
        "rgba(9,6,17,0.35)"
    );

    drawNebulaBlob(
        canvas.width * (0.75 - 0.03 * Math.cos(t)),
        canvas.height * 0.65,
        canvas.width * 0.40,
        canvas.height * 0.24,
        "rgba(17,35,43,0.30)"
    );

    drawNebulaBlob(
        canvas.width * 0.60,
        canvas.height * 0.20,
        canvas.width * 0.28,
        canvas.height * 0.20,
        "rgba(12,33,81,0.22)"
    );
}

function drawNebulaBlob(x, y, rx, ry, color) {

    ctx.save();

    // Stretch horizontally
    ctx.translate(x, y);
    ctx.scale(1, ry / rx);

    const gradient = ctx.createRadialGradient(
        0, 0, 0,
        0, 0, rx
    );

    gradient.addColorStop(0, color);
    gradient.addColorStop(1, "transparent");

    ctx.fillStyle = gradient;

    ctx.beginPath();
    ctx.arc(0, 0, rx, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
}

function drawStars(list,time){

    for(const s of list){

        s.y -= s.speed;

        if(s.y < -5){
            s.y = canvas.height + 5;
            s.x = Math.random()*canvas.width;
        }

        const a = 0.35 + 0.65 * Math.abs(Math.sin(time*0.001 + s.twinkle));

        ctx.globalAlpha = a;
        ctx.fillStyle = s.color;

        ctx.beginPath();
        ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
        ctx.fill();
    }

    ctx.globalAlpha = 1;
}

function drawShootingStars(){

    for(let i=shootingStars.length-1;i>=0;i--){

        const s = shootingStars[i];

        s.x += s.vx;
        s.y += s.vy;
        s.life++;

        ctx.strokeStyle="rgba(255, 255, 255, 0.45)";
        ctx.lineWidth=2;

        ctx.beginPath();
        ctx.moveTo(s.x,s.y);
        ctx.lineTo(s.x+90,s.y-55);
        ctx.stroke();

        if(s.life>s.maxLife)
            shootingStars.splice(i,1);
    }
}

function animate(time){

    ctx.clearRect(0,0,canvas.width,canvas.height);

    drawNebula(time);

    drawStars(starsSmall,time);
    drawStars(starsMedium,time);
    drawStars(starsLarge,time);

    drawShootingStars();

    requestAnimationFrame(animate);
}

requestAnimationFrame(animate);

</script>